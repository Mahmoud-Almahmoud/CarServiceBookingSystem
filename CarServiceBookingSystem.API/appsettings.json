{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "CarServiceBookingSystem",
    "Audience": "CarServiceBookingSystemUsers",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 30
  },
  "Stripe": {
    "Currency": "aed"
  },
  "GoogleMaps": {
    "GeocodingBaseUrl": "https://maps.googleapis.com/maps/api/geocode/",
    "RoutesBaseUrl": "https://routes.googleapis.com/"
  },
  "OpenRouteService": {
    "BaseUrl": "https://api.openrouteservice.org/"
  },
  "BookingCleanup": {
    "Enabled": true,
    "PendingBookingExpiryMinutes": 30,
    "BatchSize": 100
  }

}
