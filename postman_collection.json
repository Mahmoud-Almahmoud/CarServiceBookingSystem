      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "carId",
      "value": "1"
    },
    {
      "key": "serviceId",
      "value": "1"
    },
    {
      "key": "bookingId",
      "value": "1"
    },
    {
      "key": "carTrimId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "emailConfirmationToken",
      "value": ""
    },
    {
      "key": "X-Device-Fingerprint",
      "value": ""
    },
    {
      "key": "apiKeyId",
      "value": "1"
    },
    {
      "key": "apiKeyRaw",
      "value": ""
